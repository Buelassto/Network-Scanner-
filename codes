#!/usr/bin/env python3
"""Quick live‑host discovery using Nmap ping sweep.

The script accepts optional arguments:
  --cidr    CIDR block to scan (default 192.168.1.0/24)
  --timeout Seconds to let Nmap run (default 120)
  --timing  Nmap timing template 0‑5 (default 4 for aggressive).

It prints a single line:
    FOUND_HOSTS: ip1, ip2, ...
so downstream tools can easily parse the result.
"""

import subprocess
import re
import sys
import argparse


def run_nmap(cidr: str, timeout_secs: int = 120, timing: str = "4") -> None:
    """Run ``nmap -sn`` on *cidr* with the given timeout and timing.

    Parameters
    ----------
    cidr: str
        Network range to scan, e.g. ``192.168.1.0/24``.
    timeout_secs: int, optional
        Maximum seconds to let Nmap run (default 120).
    timing: str, optional
        Nmap timing template ``0``‑``5`` (default ``4`` – aggressive).
    """
    try:
        result = subprocess.run(
            ["nmap", "-sn", f"-T{timing}", cidr],
            capture_output=True,
            text=True,
            timeout=timeout_secs,
        )
        output = result.stdout
    except FileNotFoundError:
        print("ERROR: Nmap binary not found. Please install Nmap first.", file=sys.stderr)
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print(f"ERROR: Nmap timed out after {timeout_secs}s", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)

    hosts = []
    for line in output.splitlines():
        m = re.search(r"Nmap scan report for (\S+)", line)
        if m:
            hosts.append(m.group(1))
    print("FOUND_HOSTS: " + ", ".join(hosts))


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Quick live‑host discovery using Nmap ping sweep")
    parser.add_argument("--cidr", default="192.168.1.0/24",
                        help="CIDR block to scan (default 192.168.1.0/24)")
    parser.add_argument("--timeout", type=int, default=120,
                        help="Nmap subprocess timeout in seconds (default 120)")
    parser.add_argument("--timing", default="4",
                        help="Nmap timing template 0‑5 (default 4 for aggressive)")
    args = parser.parse_args()
    run_nmap(args.cidr, args.timeout, args.timing)
